<div class="sb-user"><div class="avatar-mini">AD</div><div><strong>Ada Danladi</strong><div class="small">Worker · KYC verified</div></div></div>
</aside>

<main class="main">
<section class="page">
<div class="page-head">
<div>
<span class="eyebrow"><i class="ti ti-layout-grid"></i>Browse Tasks</span>
<h1>Find your next task</h1>
<p class="lead">Complete micro-jobs, social tasks, and campaigns. Earn Naira or USDC instantly.</p>
</div>
<a href="post-task.html" class="btn primary" style="flex-shrink:0"><i class="ti ti-square-plus"></i>Post a Task</a>
</div>

<!-- Stats -->
<div class="stats-row">
<div class="stat-card"><div class="stat-val" id="totalTasks">0</div><div class="stat-lbl">Total Tasks</div></div>
<div class="stat-card"><div class="stat-val" style="color:var(--accent2)" id="openTasks">0</div><div class="stat-lbl">Open</div></div>
<div class="stat-card"><div class="stat-val" style="color:var(--green)" id="completedTasks">0</div><div class="stat-lbl">Completed</div></div>
<div class="stat-card"><div class="stat-val" style="color:var(--gold)" id="totalRewards">₦0</div><div class="stat-lbl">Total Rewards</div></div>
</div>

<!-- Filter bar -->
<div class="filter-bar">
<div class="search-wrap">
<i class="ti ti-search si"></i>
<input type="text" id="searchInput" placeholder="Search tasks..." oninput="debounceSearch()">
</div>
<div class="filter-btn-group" id="catFilters">
<button class="btn primary sm" data-cat="all">All</button>
<button class="btn sm" data-cat="social">Social</button>
<button class="btn sm" data-cat="content">Content</button>
<button class="btn sm" data-cat="crypto">Crypto</button>
<button class="btn sm" data-cat="web">Web</button>
</div>
</div>

<!-- Loading -->
<div id="loading" class="loading-state"><i class="ti ti-loader" style="animation:spin 1s linear infinite"></i><p>Loading tasks...</p></div>

<!-- Task Grid -->
<div id="taskGrid" class="task-grid" style="display:none"></div>

<!-- Empty -->
<div id="emptyState" class="empty-state" style="display:none"><i class="ti ti-briefcase-off"></i><p>No tasks found</p><p class="sub">Try a different category or check back later.</p></div>
</section>
</main>
</div>

<div class="toast" id="toast">Done</div>

<style>
@keyframes spin{to{transform:rotate(360deg)}}
.mobile-bottom-nav{position:fixed;left:0;right:0;bottom:0;z-index:250;display:none;grid-template-columns:repeat(5,1fr);align-items:end;height:88px;padding:8px 12px 10px;background:rgba(255,255,255,.96);border-top:1px solid var(--border);box-shadow:0 -10px 30px rgba(16,21,37,.08);backdrop-filter:blur(18px) saturate(1.25)}
[data-theme="dark"] .mobile-bottom-nav{background:rgba(5,7,11,.96);border-top-color:#252b36;box-shadow:none}
.mobile-bottom-nav a{min-width:0;display:grid;justify-items:center;gap:4px;color:#66738a;font-size:13px;font-weight:800;text-decoration:none}
.mobile-bottom-nav svg{width:28px;height:28px;stroke-width:2.2}
.mobile-bottom-nav .active,.mobile-bottom-nav a:hover{color:#101525}
[data-theme="dark"] .mobile-bottom-nav a{color:#8b96a8}
[data-theme="dark"] .mobile-bottom-nav .active,[data-theme="dark"] .mobile-bottom-nav a:hover{color:#f8fafc}
.mobile-bottom-nav .create{transform:translateY(-18px);gap:5px;color:#101525}
.mobile-bottom-nav .create svg{width:58px;height:58px;padding:15px;border-radius:18px;background:#101525;color:#fff;box-shadow:0 10px 22px rgba(16,21,37,.24)}
[data-theme="dark"] .mobile-bottom-nav .create svg{background:#f8fafc;color:#05070b;box-shadow:0 0 22px rgba(167,139,250,.18)}
@media(max-width:768px){.mobile-bottom-nav{display:grid}}
</style>

<nav class="mobile-bottom-nav" aria-label="Mobile app navigation">
  <a href="tasks.html" class="active"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v13H4V7Z"/><path d="M9 5V3h6v2M8 11h8"/></svg><span>Jobs</span></a>
  <a href="store.html"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/></svg><span>Deals</span></a>
  <a href="post-task.html" class="create"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg><span>Create</span></a>
  <a href="notifications.html"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg><span>Alerts</span></a>
  <a href="dashboard.html"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Profile</span></a>
</nav>

<script>
// ── Sample tasks data ──────────────────────────────
const sampleTasks = [
  { id:1,cat:"social",platform:"X / Twitter",title:"X repost campaign",desc:"Follow and repost the pinned launch post. Earn rewards instantly after verification.",pay:"₦500",payUsd:"$0.35",spots:24,open:true },
  { id:2,cat:"social",platform:"Telegram",title:"Telegram community join",desc:"Join a verified group and submit your username. Quick and easy task.",pay:"₦250",payUsd:"$0.18",spots:50,open:true },
  { id:3,cat:"content",platform:"Google Play",title:"Android beta test",desc:"Install the beta app and report issues. Help us improve before launch.",pay:"₦2,000",payUsd:"$1.40",spots:10,open:true },
  { id:4,cat:"content",platform:"Web",title:"AI survey",desc:"Answer product research questions about AI tools and preferences.",pay:"1.50 USDC",payUsd:"$1.50",spots:35,open:true },
  { id:5,cat:"crypto",platform:"Web3",title:"Wallet signup QA",desc:"Create a wallet test account and submit proof of completion.",pay:"2 USDC",payUsd:"$2.00",spots:20,open:true },
  { id:6,cat:"social",platform:"Instagram",title:"Instagram reel comment",desc:"Leave a relevant comment on the campaign reel to boost engagement.",pay:"₦300",payUsd:"$0.21",spots:15,open:true },
  { id:7,cat:"web",platform:"Website",title:"Sign-up & profile setup",desc:"Register on partner platform and complete your profile for rewards.",pay:"₦800",payUsd:"$0.56",spots:30,open:true },
  { id:8,cat:"social",platform:"TikTok",title:"TikTok video repost",desc:"Repost the campaign video on your TikTok account. Proof required.",pay:"₦450",payUsd:"$0.32",spots:18,open:true },
  { id:9,cat:"content",platform:"YouTube",title:"Video feedback",desc:"Watch a 2-min video and leave constructive feedback in comments.",pay:"1 USDC",payUsd:"$1.00",spots:12,open:true },
];

let filteredTasks = [...sampleTasks];
let currentCat = 'all';
let currentSearch = '';
let debounceTimer;

function debounceSearch() {
  clearTimeout(debounceTimer);
  debounceTimer = setTimeout(renderTasks, 300);
}

function renderTasks() {
  const grid = document.getElementById('taskGrid');
  const loading = document.getElementById('loading');
  const empty = document.getElementById('emptyState');

  const search = (document.getElementById('searchInput')?.value || '').toLowerCase();

  filteredTasks = sampleTasks.filter(t => {
    const matchCat = currentCat === 'all' || t.cat === currentCat;
    const matchSearch = !search || t.title.toLowerCase().includes(search) || t.platform.toLowerCase().includes(search);
    return matchCat && matchSearch;
  });

  // Update stats
  document.getElementById('totalTasks').textContent = sampleTasks.length;
  document.getElementById('openTasks').textContent = sampleTasks.filter(t => t.open).length;
  document.getElementById('completedTasks').textContent = sampleTasks.filter(t => !t.open).length;
  const totalNgn = sampleTasks.filter(t => t.pay.startsWith('₦')).reduce((s,t) => s + parseInt(t.pay.replace(/[^0-9]/g,'')), 0);
  document.getElementById('totalRewards').textContent = '₦' + totalNgn.toLocaleString();

  loading.style.display = 'none';

  if (filteredTasks.length === 0) {
    grid.style.display = 'none';
    empty.style.display = 'block';
    return;
  }

  grid.style.display = 'grid';
  empty.style.display = 'none';

  grid.innerHTML = filteredTasks.map(t => `
    <article class="task-card">
      <div class="tc-head">
        <span class="tc-cat"><i class="ti ti-${t.cat === 'social' ? 'messages' : t.cat === 'content' ? 'file-text' : t.cat === 'crypto' ? 'coin' : 'globe'}"></i>${t.platform}</span>
        <span class="tc-pay">${t.pay} ${t.payUsd ? '<span class="usd">' + t.payUsd + '</span>' : ''}</span>
      </div>
      <h3>${t.title}</h3>
      <p class="tc-desc">${t.desc}</p>
      <div class="tc-meta">
        <span><i class="ti ti-users"></i>${t.spots} spots left</span>
        <span><i class="ti ti-clock"></i>${t.open ? 'Open' : 'Closed'}</span>
        <span><i class="ti ti-file-check"></i>Proof required</span>
      </div>
      <div class="tc-foot">
        <button class="btn primary" onclick="applyTask(${t.id})"><i class="ti ti-send"></i>Apply Now</button>
        <span class="spots">${t.spots} left</span>
      </div>
    </article>
  `).join('');
}

function applyTask(id) {
  const btn = event.target.closest('button');
  btn.disabled = true;
  btn.innerHTML = '<i class="ti ti-check"></i>Applied';
  btn.classList.add('applied');
  say('Application submitted');
}

function say(text) {
  const toast = document.getElementById('toast');
  if (!toast) return;
  toast.textContent = text;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 1800);
}

// ── Filter handling ────────────────────────────────
document.addEventListener('click', e => {
  const f = e.target.closest('[data-cat]');
  if (f) {
    document.querySelectorAll('[data-cat]').forEach(b => {
      b.classList.toggle('primary', b === f);
      b.classList.toggle('outline', b !== f);
    });
    currentCat = f.dataset.cat;
    renderTasks();
  }
});

// ── Theme toggle ───────────────────────────────────
function t() {
  const html = document.documentElement;
  const cur = html.getAttribute('data-theme') || 'light';
  const next = cur === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  try { localStorage.setItem('ogapay-theme', next); } catch(e) {}
  const icon = document.getElementById('ti');
  if (icon) icon.className = next === 'dark' ? 'ti ti-sun' : 'ti ti-moon';
}

// ── Init ───────────────────────────────────────────
(function() {
  const html = document.documentElement;
  html.setAttribute('data-theme', html.getAttribute('data-theme') || 'light');
  const icon = document.getElementById('ti');
  if (icon) icon.className = html.getAttribute('data-theme') === 'dark' ? 'ti ti-sun' : 'ti ti-moon';
  renderTasks();
})();
</script>
<script src="assets/ogapay-live.js"></script>
</body>
</html>
