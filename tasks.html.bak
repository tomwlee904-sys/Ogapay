<div class="app">
<aside class="sidebar">
<a href="post-task.html" class="sb-cta"><i class="ti ti-square-plus"></i>Post a Task</a>
<span class="sb-label">Main</span>
<a class="sb-item" href="dashboard.html"><span class="sb-icon"><i class="ti ti-dashboard"></i></span>Dashboard</a>
<a class="sb-item" href="profile.html"><span class="sb-icon"><i class="ti ti-user-circle"></i></span>Profile</a>
