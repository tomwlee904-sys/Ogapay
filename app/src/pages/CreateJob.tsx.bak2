import { useState, useMemo, useRef, useEffect, useCallback } from 'react'
import { useNavigate } from 'react-router-dom'
import Layout from '../components/Layout'

// ─── Types ───
type JobType = 'select' | 'quick' | 'social' | 'custom'
type Step = 'choose-type' | 'post-details' | 'payment'
type WinnerMode = 'creator_picks' | 'random' | 'challenge' | 'selection'
type RequirementMode = 'default' | 'rank' | 'sorsa' | 'x_metrics' | 'holdings' | 'seeker' | 'x_verified'
type Currency = 'SOL' | 'USDC' | 'NGN'

interface ActionConfig {
  id: string; label: string; description: string
  minPer: number; maxPerComponent: number
  icon: string; platformId: string
}

interface SocialConfig {
  enabled: boolean; actionId: string; amount: number; budget: number
}

interface ComponentConfig {
  enabled: boolean; amount: number; budget: number
  minRank: number; humanVerified: boolean
}

interface PostSnapshot {
  id: string; text: string; authorName: string; authorHandle: string
  mediaUrls: string[]; profileImageUrl?: string
}

interface CustomJobTemplate {
  id: string; label: string; description: string
  categoryMain?: string; categorySub?: string
  attachmentUrls: string[]; publicFlag: number
  createdAt?: string; isOwner?: boolean
}

