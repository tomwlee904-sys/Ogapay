  comment: 'Write a short, natural comment about this post. Keep it positive and avoid spam or repeated text. Make sure your comment is meaningful and in context.',
  quote: 'Share this post with your own thoughts. Explain why you agree or disagree, and add value to the conversation.',
}

// ─── Helpers ───
const formatSol = (v: number) => v.toFixed(3)
const isValidUrl = (s: string) => { try { new URL(s); return true } catch { return false } }
const detectPlatform = (url: string): string | null => {
  if (/x\.com|twitter\.com/i.test(url)) return 'x'
  if (/instagram\.com/i.test(url)) return 'instagram'
  if (/youtube\.com|youtu\.be/i.test(url)) return 'youtube'
  if (/t\.me|telegram\./i.test(url)) return 'telegram'
  if (/discord\.gg|discord\.com/i.test(url)) return 'discord'
  if (/tiktok\.com/i.test(url)) return 'tiktok'
  return null
}

// ─── Sub-components ───

function InfoIcon({ label, onClick }: { label: string; onClick: () => void }) {
  return (
    <button type="button" onClick={onClick} className="info-icon-btn" aria-label={label}
      style={{ background: 'none', border: 'none', cursor: 'pointer', padding: 4, display: 'inline-flex', alignItems: 'center', color: 'var(--text3)' }}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
      </svg>
    </button>
  )
}

function BreadcrumbSteps({ step }: { step: Step }) {
  const steps = [
    { key: 'choose-type', label: 'Choose Type' },
    { key: 'post-details', label: 'Task Details' },
    { key: 'payment', label: 'Payment' },
  ]
  const currentIdx = steps.findIndex(s => s.key === step)
  return (
    <div className="breadcrumb-steps" style={{ display: 'flex', gap: 8, alignItems: 'center', marginBottom: 24, flexWrap: 'wrap' }}>
      {steps.map((s, i) => (
        <div key={s.key} style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
          <div style={{
            width: 28, height: 28, borderRadius: '50%', display: 'flex', alignItems: 'center', justifyContent: 'center',
            fontSize: 12, fontWeight: 700,
            background: i < currentIdx ? 'var(--accent)' : i === currentIdx ? 'var(--accent)' : 'var(--bg2)',
            color: i <= currentIdx ? '#fff' : 'var(--text3)',
            transition: 'all .2s',
          }}>
            {i < currentIdx ? (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3"><path d="M20 6L9 17l-5-5" strokeLinecap="round" strokeLinejoin="round"/></svg>
            ) : i + 1}
          </div>
          <span style={{ fontSize: 13, fontWeight: i === currentIdx ? 700 : 500, color: i <= currentIdx ? 'var(--text)' : 'var(--text3)' }}>{s.label}</span>
          {i < steps.length - 1 && <span style={{ color: 'var(--border)', margin: '0 4px' }}>→</span>}
        </div>
      ))}
    </div>
  )
}

function InfoModal({ open, onClose }: { open: boolean; onClose: () => void }) {
  if (!open) return null
  return (
    <div className="modal-overlay" onClick={onClose} style={{ position: 'fixed', inset: 0, zIndex: 1000, background: 'rgba(0,0,0,0.6)', display: 'flex', alignItems: 'center', justifyContent: 'center', padding: 16 }}>
      <div className="modal-content" onClick={e => e.stopPropagation()} style={{
        background: 'var(--card)', borderRadius: 16, maxWidth: 600, width: '100%', maxHeight: '90vh', overflow: 'auto',
        border: '1px solid var(--border)', padding: 24,
      }}>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20 }}>
          <h2 style={{ margin: 0, fontSize: 20, fontWeight: 800, color: 'var(--text)' }}>Understanding Task Modes</h2>
          <button onClick={onClose} style={{ background: 'none', border: 'none', cursor: 'pointer', color: 'var(--text3)', fontSize: 20 }}>✕</button>
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16, marginBottom: 24 }}>
          <div style={{ borderRadius: 12, border: '1px solid var(--accent)', padding: 16, background: 'var(--bg2)' }}>
            <h3 style={{ margin: '0 0 8px', fontSize: 15, fontWeight: 700, color: 'var(--accent)' }}>⚡ Challenge Mode</h3>
            <ul style={{ padding: '0 0 0 16px', margin: 0, fontSize: 13, color: 'var(--text2)', lineHeight: 1.8 }}>
              <li>Multiple winners (1–1000)</li>
              <li>You review all submissions</li>
              <li>Select the best entries</li>
              <li>Reward split among winners</li>
              <li>Best for: design, writing, memes, content</li>
            </ul>
          </div>
          <div style={{ borderRadius: 12, border: '1px solid var(--border)', padding: 16, background: 'var(--bg2)' }}>
            <h3 style={{ margin: '0 0 8px', fontSize: 15, fontWeight: 700, color: 'var(--text)' }}>🎯 Selection Mode</h3>
            <ul style={{ padding: '0 0 0 16px', margin: 0, fontSize: 13, color: 'var(--text2)', lineHeight: 1.8 }}>
              <li>One winner selected</li>
              <li>Applicants explain qualifications</li>
              <li>Direct chat with selected worker</li>
              <li>Full reward to one person</li>
              <li>Best for: dev work, consulting, long-term</li>
            </ul>
          </div>
        </div>

        <div style={{ marginBottom: 16 }}>
          <h3 style={{ fontSize: 14, fontWeight: 700, color: 'var(--text)', marginBottom: 12 }}>Field Explanations</h3>
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12, fontSize: 12, color: 'var(--text2)' }}>
            {[
              ['Winners', 'Number of participants who will receive rewards'],
              ['Max Entries', 'Maximum number of people who can apply'],
              ['Selection Mode', 'How winners are chosen (creator picks or random)'],
              ['Audience', 'Target everyone or a specific community'],
              ['Selection Time', 'Deadline for accepting submissions'],
              ['Hide Submissions', 'Keep entries private until job closes'],
              ['Category', 'Type of task for better discoverability'],
              ['Search Tags', 'Keywords to help workers find your task'],
            ].map(([label, desc]) => (
              <div key={label} style={{ padding: '8px 12px', borderRadius: 8, background: 'var(--bg)' }}>
                <strong style={{ color: 'var(--text)', display: 'block', marginBottom: 2 }}>{label}</strong>
                <span>{desc}</span>
              </div>
            ))}
          </div>
        </div>
        <button onClick={onClose} className="btn-primary" style={{ width: '100%' }}>Got it</button>
      </div>
    </div>
  )
}

function SelectDropdown({ options, value, onChange, placeholder }: {
  options: { value: string; label: string }[]
  value: string; onChange: (v: string) => void; placeholder?: string
}) {
  return (
    <select value={value} onChange={e => onChange(e.target.value)}
      style={{
        padding: '8px 12px', borderRadius: 8, border: '1px solid var(--border)',
        background: 'var(--card)', color: 'var(--text)', fontSize: 13, width: '100%',
        cursor: 'pointer', outline: 'none',
      }}>
      {placeholder && <option value="" disabled>{placeholder}</option>}
      {options.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
    </select>
  )
}

// ─── Main Component ───
export default function CreateJob() {
  const navigate = useNavigate()
  const isDark = typeof document !== 'undefined' && document.documentElement.dataset.theme === 'dark'

  // Step state
  const [step, setStep] = useState<Step>('choose-type')
  const [jobType, setJobType] = useState<JobType>('select')
  const [showInfoModal, setShowInfoModal] = useState(false)
  const [showSuccess, setShowSuccess] = useState(false)

  // Post URL
  const [postUrl, setPostUrl] = useState('')
  const [postPreview, setPostPreview] = useState<PostSnapshot | null>(null)
  const [fetchingPost, setFetchingPost] = useState(false)
  const [postError, setPostError] = useState('')

  // Custom job form
  const [winnerMode, setWinnerMode] = useState<WinnerMode>('challenge')
  const [winners, setWinners] = useState(1)
  const [maxEntries, setMaxEntries] = useState(100)
  const [unlimitedEntries, setUnlimitedEntries] = useState(false)
  const [hideSubmissions, setHideSubmissions] = useState(false)
  const [screenshotProof, setScreenshotProof] = useState(true)
  const [watermark, setWatermark] = useState(true)
  const [category, setCategory] = useState('')
  const [subcategory, setSubcategory] = useState('')
  const [title, setTitle] = useState('')
  const [description, setDescription] = useState('')
  const [attachments, setAttachments] = useState<File[]>([])
  const [budget, setBudget] = useState(0.1)
  const [payPerWorker, setPayPerWorker] = useState(0)
  const [currency, setCurrency] = useState<Currency>('SOL')
  const [coinPrice, setCoinPrice] = useState(0)
  // NGN fields
  const [ngnBudget, setNgnBudget] = useState(5000)
  const [ngnPayPerWorker, setNgnPayPerWorker] = useState(0)
  const [selectionTime, setSelectionTime] = useState('1440')
  const [audience, setAudience] = useState<'all' | 'community'>('all')
  const [communityId, setCommunityId] = useState('')
  const [tags, setTags] = useState('')
  const [excludeJobs, setExcludeJobs] = useState<string[]>([])

  // Requirements
  const [reqMode, setReqMode] = useState<RequirementMode>('default')
  const [reqRank, setReqRank] = useState(0)
  const [reqSorsa, setReqSorsa] = useState(0)
  const [reqXMetrics, setReqXMetrics] = useState(0)
  const [reqHoldings, setReqHoldings] = useState(0)
  const [humanVerified, setHumanVerified] = useState(false)

  // Extra settings
  const [cooldown, setCooldown] = useState('0')
  const [hideAfterCompletion, setHideAfterCompletion] = useState(false)

  // Quick / Social state
  const [quickUrl, setQuickUrl] = useState('')
  const [quickPlatform, setQuickPlatform] = useState('x')
  const [quickAction, setQuickAction] = useState('reposts')
  const [quickAmount, setQuickAmount] = useState(50)
  const [quickBudget, setQuickBudget] = useState(0.25)

  const [socialConfigs, setSocialConfigs] = useState<Record<string, SocialConfig>>({})
  const [commentInstructions, setCommentInstructions] = useState(DEFAULT_INSTRUCTIONS.comment)
  const [showExtraSettings, setShowExtraSettings] = useState(false)
  const [aiSuggestions, setAiSuggestions] = useState<string[]>([])
  const [generatingAI, setGeneratingAI] = useState(false)

  // Templates
  const [showTemplates, setShowTemplates] = useState(false)
  const [templates, setTemplates] = useState<CustomJobTemplate[]>([])
  const [loadingTemplates, setLoadingTemplates] = useState(false)

  // Submitting
  const [submitting, setSubmitting] = useState(false)
  const [submitError, setSubmitError] = useState('')

  // Budget auto-calc
  useEffect(() => {
    if (winners > 0 && budget > 0) {
      const perWorker = budget * (1 - 0.1) / winners
      setPayPerWorker(perWorker)
    }
  }, [winners, budget])

  useEffect(() => {
    if (winners > 0 && ngnBudget > 0) {
      setNgnPayPerWorker(ngnBudget * (1 - 0.1) / winners)
    }
  }, [winners, ngnBudget])

  // Fetch post preview
  const fetchPostPreview = useCallback(async () => {
    if (!postUrl || !isValidUrl(postUrl)) { setPostError('Please paste a valid URL'); return }
    setFetchingPost(true); setPostError(''); setPostPreview(null)
    try {
      const platform = detectPlatform(postUrl)
      let snapshot: PostSnapshot = {
        id: String(Date.now()), text: `Post from ${postUrl}`,
        authorName: 'User', authorHandle: platform ? `@${platform}_user` : '@user',
        mediaUrls: []
      }
      // Try to fetch Open Graph data via a simple embed
      try {
        const resp = await fetch(`/api/embed?url=${encodeURIComponent(postUrl)}`)
        if (resp.ok) {
          const data = await resp.json()
          if (data?.title) snapshot.text = data.title
          if (data?.description) snapshot.text = data.description
          if (data?.image) snapshot.mediaUrls = [data.image]
          if (data?.authorName) snapshot.authorName = data.authorName
          if (data?.authorHandle) snapshot.authorHandle = data.authorHandle
        }
      } catch {}
      setPostPreview(snapshot)
      // Auto-detect platform
      if (platform) setQuickPlatform(platform)
    } catch { setPostError('Failed to fetch post preview') }
    finally { setFetchingPost(false) }
  }, [postUrl])

  // Load templates
  useEffect(() => {
    if (showTemplates && templates.length === 0) {
      setLoadingTemplates(true)
      fetch('/api/custom/templates', { credentials: 'include' })
        .then(r => r.json().catch(() => ({})))
        .then(d => { setTemplates(Array.isArray(d) ? d : d?.templates ? d.templates : []) })
        .catch(() => {})
        .finally(() => setLoadingTemplates(false))
    }
  }, [showTemplates])

  const getActionsForPlatform = (platformId: string) => ACTIONS.filter(a => a.platformId === platformId)
  const getDefaultAction = (platformId: string) => {
    const actions = getActionsForPlatform(platformId)
    return actions[0]?.id || 'reposts'
  }

  const getSocialConfig = (platformId: string): SocialConfig => {
    const actions = getActionsForPlatform(platformId)
    const defaultAction = actions[0]?.id || 'reposts'
    return socialConfigs[platformId] || { enabled: false, actionId: defaultAction, amount: 50, budget: 0.25 }
  }

  const updateSocialConfig = (platformId: string, updates: Partial<SocialConfig>) => {
    setSocialConfigs(prev => ({
      ...prev,
      [platformId]: { ...getSocialConfig(platformId), ...updates }
    }))
  }

  const toggleSocialPlatform = (platformId: string) => {
    const config = getSocialConfig(platformId)
    updateSocialConfig(platformId, { enabled: !config.enabled })
  }

  const changePlatformAction = (platformId: string, actionId: string) => {
    const action = ACTIONS.find(a => a.id === actionId)
    updateSocialConfig(platformId, { actionId, amount: 50, budget: action ? action.minPer * 50 : 0.25 })
  }

  const enabledSocialCount = Object.values(socialConfigs).filter(c => c.enabled).length
  const socialTotalCompletions = Object.values(socialConfigs)
    .filter(c => c.enabled)
    .reduce((sum, c) => sum + c.amount, 0)
  const socialTotalBudget = Object.values(socialConfigs)
    .filter(c => c.enabled)
    .reduce((sum, c) => sum + c.budget, 0)
  const socialFee = socialTotalBudget * 0.1
  const socialGrandTotal = socialTotalBudget + socialFee

  const handlePay = async () => {
    if (jobType === 'quick') {
      const currentActions = getActionsForPlatform(quickPlatform)
      const selectedAction = ACTIONS.find(a => a.id === quickAction) || currentActions[0]
      const minBudget = selectedAction ? selectedAction.minPer * quickAmount : 0.25
      const quickFee = Math.max(quickBudget, minBudget) * 0.1
      const quickTotal = Math.max(quickBudget, minBudget) + quickFee
      setBudget(quickTotal)
      setStep('payment')
      return
    }
    if (jobType === 'custom') {
      if (!title.trim()) { setSubmitError('Please enter a task title'); return }
      if (!description.trim()) { setSubmitError('Please enter a task description'); return }
      if (budget < 0.01 && currency === 'SOL') { setSubmitError('Minimum budget is 0.01 SOL'); return }
      if (ngnBudget < 500 && currency === 'NGN') { setSubmitError('Minimum budget is ₦500'); return }
      setShowSuccess(true)
      return
    }
    setStep('payment')
  }

  const applyTemplate = (tpl: CustomJobTemplate) => {
    setTitle(tpl.label || '')
    setDescription(tpl.description || '')
    if (tpl.categoryMain) setCategory(tpl.categoryMain)
    if (tpl.categorySub) setSubcategory(tpl.categorySub)
    setShowTemplates(false)
  }

  const applyPreset = (preset: typeof TEMPLATE_PRESETS[0]) => {
    setTitle(preset.label)
    setDescription(preset.description)
    setShowTemplates(false)
  }

  const generateAISuggestions = async () => {
    if (!commentInstructions.trim() || generatingAI) return
    setGeneratingAI(true)
    try {
      const resp = await fetch('/api/ai/comments/suggest', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          jobType: 'comment',
          messageMarkdown: commentInstructions,
          count: 50,
        })
      })
      const data = await resp.json()
      if (resp.ok) {
        setAiSuggestions(Array.isArray(data?.suggestions) ? data.suggestions : [])
      }
    } catch {}
    finally { setGeneratingAI(false) }
  }

  const styles = `
.create-page { max-width: 900px; margin: 0 auto; padding: 24px 16px; }
.create-header { margin-bottom: 24px; }
.create-header h1 { font-size: 24px; font-weight: 800; margin: 0 0 4px; color: var(--text); }
.create-header p { font-size: 14px; color: var(--text2); margin: 0; }

/* Mode Cards */
.mode-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 32px; }
@media(max-width:700px){ .mode-grid { grid-template-columns: 1fr; } }
.mode-card {
  border: 1px solid var(--border); border-radius: 14px; padding: 20px; cursor: pointer;
  transition: all .2s; background: var(--card);
}
.mode-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(124,58,237,0.1); }
.mode-card.active { border-color: var(--accent); background: var(--bg2); }
.mode-card-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 12px; }
.mode-card h3 { margin: 0 0 4px; font-size: 16px; font-weight: 700; color: var(--text); }
.mode-card p { margin: 0; font-size: 13px; color: var(--text2); line-height: 1.5; }

/* Form sections */
.form-section { margin-bottom: 24px; }
.form-section-title { font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
@media(max-width:600px){ .form-row { grid-template-columns: 1fr; } }
.form-group { display: flex; flex-direction: column; gap: 4px; }
.form-group label { font-size: 12px; font-weight: 600; color: var(--text3); text-transform: uppercase; letter-spacing: .04em; }
.form-input, .form-textarea, .form-select {
  padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border);
  background: var(--bg); color: var(--text); font-size: 14px; width: 100%;
  transition: border-color .2s; box-sizing: border-box;
}
.form-input:focus, .form-textarea:focus, .form-select:focus { border-color: var(--accent); outline: none; }
.form-textarea { min-height: 100px; resize: vertical; font-family: inherit; }
.form-hint { font-size: 11px; color: var(--text3); margin: 4px 0 0; }
.form-checkbox { display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; color: var(--text); }
.form-checkbox input { width: 16px; height: 16px; accent-color: var(--accent); }

/* Post preview */
.post-preview { border: 1px solid var(--border); border-radius: 12px; padding: 16px; background: var(--card); margin-bottom: 16px; }
.post-preview-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.post-preview-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--bg2); display: flex; align-items: center; justify-content: center; color: var(--text3); font-size: 14px; }
.post-preview-name { font-size: 14px; font-weight: 700; color: var(--text); }
.post-preview-handle { font-size: 12px; color: var(--text3); }
.post-preview-text { font-size: 13px; color: var(--text2); line-height: 1.5; margin-bottom: 10px; }
.post-preview-media { display: flex; gap: 8px; overflow-x: auto; }
.post-preview-media img { max-height: 200px; border-radius: 8px; }

/* Tabs */
.tab-bar { display: flex; gap: 0; margin-bottom: 20px; border-bottom: 1px solid var(--border); }
.tab-item {
  padding: 10px 20px; font-size: 13px; font-weight: 600; color: var(--text3); cursor: pointer;
  border-bottom: 2px solid transparent; transition: all .2s;
}
.tab-item:hover { color: var(--text); }
.tab-item.active { color: var(--accent); border-bottom-color: var(--accent); }

/* Template picker */
.template-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
@media(max-width:600px){ .template-grid { grid-template-columns: 1fr; } }
.template-card {
  border: 1px solid var(--border); border-radius: 10px; padding: 14px; cursor: pointer; background: var(--card);
  transition: all .15s;
}
.template-card:hover { border-color: var(--accent); }
.template-card h4 { margin: 0 0 4px; font-size: 14px; font-weight: 700; color: var(--text); }
.template-card p { margin: 0; font-size: 12px; color: var(--text2); line-height: 1.4; }

/* URL bar */
.url-bar { display: flex; gap: 8px; margin-bottom: 16px; }
.url-bar .form-input { flex: 1; }
@media(max-width:600px){ .url-bar { flex-direction: column; } }

/* Platform accordion */
.platform-block { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin-bottom: 12px; }
.platform-block-header {
  display: flex; align-items: center; gap: 10px; padding: 12px 14px; cursor: pointer;
  background: var(--card); transition: background .15s;
}
.platform-block-header:hover { background: var(--bg2); }
.platform-block-icon { width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 15px; }
.platform-block-name { font-size: 14px; font-weight: 700; color: var(--text); flex: 1; }
.platform-block-toggle { font-size: 18px; color: var(--text3); transition: transform .2s; }
.platform-block-toggle.open { transform: rotate(180deg); }
.platform-block-body { padding: 0 14px 14px; display: flex; flex-direction: column; gap: 8px; }

/* Action chips */
.action-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.action-chip {
  padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600;
  border: 1px solid var(--border); background: var(--bg); color: var(--text2); cursor: pointer; transition: all .15s;
}
.action-chip:hover { border-color: var(--accent); color: var(--text); }
.action-chip.active { border-color: var(--accent); background: var(--accent); color: #fff; }

/* Summary card */
.summary-card { border: 1px solid var(--border); border-radius: 12px; padding: 20px; background: var(--card); margin-top: 20px; }
.summary-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: 14px; color: var(--text2); }
.summary-row.total { border-top: 1px solid var(--border); margin-top: 8px; padding-top: 12px; font-size: 16px; font-weight: 700; color: var(--text); }
.summary-row.total span:last-child { color: var(--accent); }
.summary-label { display: flex; align-items: center; gap: 6px; }

/* Buttons */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; transition: all .15s; border: none; }
.btn-primary { background: linear-gradient(135deg, #A78BFA, #7C3AED); color: #fff; }
.btn-primary:hover { box-shadow: 0 4px 12px rgba(124,58,237,0.3); transform: translateY(-1px); }
.btn-secondary { background: var(--bg2); color: var(--text); border: 1px solid var(--border); }
.btn-secondary:hover { background: var(--card); }
.btn-outline { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
.btn-outline:hover { background: rgba(124,58,237,0.1); }
.btn-full { width: 100%; }
.btn-sm { padding: 6px 12px; font-size: 12px; }
.btn:disabled { opacity: .5; cursor: not-allowed; transform: none !important; }

/* Info button */
.info-icon-btn { color: var(--text3); }
.info-icon-btn:hover { color: var(--accent); }

/* Modal overlay */
.modal-overlay { animation: fadeIn .2s; }
.modal-content { animation: slideUp .2s; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

/* Success overlay */
.success-overlay { position: fixed; inset: 0; z-index: 999; background: rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; }
.success-card { background: var(--card); border-radius: 16px; padding: 2rem; text-align: center; max-width: 380px; width: 90%; border: 1px solid var(--border); }
.success-icon { width: 56px; height: 56px; border-radius: 50%; background: rgba(16,163,74,.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: var(--green); }
.success-icon svg { width: 28px; height: 28px; }
.success-card h2 { font-size: 1.25rem; font-weight: 800; margin: 0 0 .5rem; color: var(--text); }
.success-card p { font-size: .8125rem; color: var(--text2); margin: 0 0 1.5rem; line-height: 1.5; }

/* Extra settings toggle */
.extra-settings-toggle {
  width: 100%; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between;
  border: 1px solid var(--border); border-radius: 10px; background: var(--card); cursor: pointer;
  font-size: 14px; font-weight: 600; color: var(--text); transition: all .15s;
}
.extra-settings-toggle:hover { background: var(--bg2); }
.extra-settings-toggle .arrow { transition: transform .2s; }
.extra-settings-toggle .arrow.open { transform: rotate(180deg); }
.extra-settings-body { padding: 16px; border: 1px solid var(--border); border-top: 0; border-radius: 0 0 10px 10px; }

/* Error */
.form-error { color: #ef4444; font-size: 13px; margin-top: 8px; }

/* AI suggestions */
.ai-suggestions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.ai-suggestion-chip {
  padding: 4px 10px; border-radius: 16px; font-size: 11px; background: var(--bg2);
  border: 1px solid var(--border); color: var(--text2); cursor: pointer; transition: all .15s;
}
.ai-suggestion-chip:hover { border-color: var(--accent); color: var(--text); }
`

  const renderChooseType = () => (
    <>
      <div className="create-header">
        <h1>Create a Task</h1>
        <p>Post social, custom, or challenge tasks for the OgaPay community to complete.</p>
      </div>

      <div className="mode-grid">
        <div className={`mode-card ${jobType === 'quick' ? 'active' : ''}`} onClick={() => setJobType('quick')}>
          <div className="mode-card-icon" style={{ background: 'rgba(59,130,246,0.1)', color: '#3b82f6' }}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3>Quick Tasks</h3>
          <p>Select a preset task type and paste your link to get started instantly.</p>
        </div>
        <div className={`mode-card ${jobType === 'social' ? 'active' : ''}`} onClick={() => setJobType('social')}>
          <div className="mode-card-icon" style={{ background: 'rgba(16,185,129,0.1)', color: '#10b981' }}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </div>
          <h3>Boost a Post</h3>
          <p>Paste any social post URL to create an engagement task around it.</p>
        </div>
        <div className={`mode-card ${jobType === 'custom' ? 'active' : ''}`} onClick={() => setJobType('custom')}>
          <div className="mode-card-icon" style={{ background: 'rgba(124,58,237,0.1)', color: '#7C3AED' }}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <h3>Custom Task</h3>
          <p>Create your own task description, challenges, or creative campaigns.</p>
        </div>
      </div>

      {jobType === 'quick' && (
        <div className="form-section">
          <div className="form-section-title">Quick Task Setup</div>
          <div className="form-row">
            <div className="form-group">
              <label>Platform</label>
              <select className="form-select" value={quickPlatform} onChange={e => {
                const p = e.target.value
                setQuickPlatform(p)
                setQuickAction(getDefaultAction(p))
              }}>
                {PLATFORMS.map(p => <option key={p.id} value={p.id}>{p.name}</option>)}
              </select>
            </div>
            <div className="form-group">
              <label>Action</label>
              <select className="form-select" value={quickAction} onChange={e => setQuickAction(e.target.value)}>
                {getActionsForPlatform(quickPlatform).map(a => <option key={a.id} value={a.id}>{a.label}</option>)}
              </select>
            </div>
          </div>
          <div className="form-row">
            <div className="form-group">
              <label>Target URL or Handle</label>
              <input className="form-input" value={quickUrl} onChange={e => setQuickUrl(e.target.value)} placeholder={`Enter ${PLATFORMS.find(p => p.id === quickPlatform)?.name} URL or handle...`} />
            </div>
          </div>
          <div className="form-row">
            <div className="form-group">
              <label>Quantity</label>
              <input className="form-input" type="number" min={10} max={1000} step={10} value={quickAmount} onChange={e => setQuickAmount(Math.min(1000, Math.max(10, Number(e.target.value) || 10)))} />
            </div>
            <div className="form-group">
              <label>Budget (SOL)</label>
              <input className="form-input" type="number" min={0.01} step={0.01} value={quickBudget} onChange={e => setQuickBudget(Math.max(0.01, Number(e.target.value) || 0.01))} />
              <span className="form-hint">Min {((ACTIONS.find(a => a.id === quickAction)?.minPer || 0.001) * quickAmount).toFixed(3)} SOL for this quantity</span>
            </div>
          </div>
          <button className="btn btn-primary btn-full" onClick={handlePay} disabled={!quickUrl.trim()}>
            Continue to Payment →
          </button>
        </div>
      )}

      {jobType === 'social' && (
        <div className="form-section">
          <div className="form-section-title">
            Boost a Post
            <InfoIcon label="About Boost a Post" onClick={() => setShowInfoModal(true)} />
          </div>
          <div className="url-bar">
            <input className="form-input" value={postUrl} onChange={e => { setPostUrl(e.target.value); setPostPreview(null) }}
              placeholder="Paste X post URL, Instagram post URL, TikTok URL..." />
            <button className="btn btn-secondary" onClick={fetchPostPreview} disabled={!postUrl.trim() || fetchingPost}>
              {fetchingPost ? 'Fetching...' : 'Fetch Post'}
            </button>
          </div>
          {postError && <div className="form-error">{postError}</div>}

          {postPreview && (
            <div className="post-preview">
              <div className="post-preview-header">
                <div className="post-preview-avatar">
                  {postPreview.authorName.charAt(0).toUpperCase()}
                </div>
                <div>
                  <div className="post-preview-name">{postPreview.authorName}</div>
                  <div className="post-preview-handle">{postPreview.authorHandle}</div>
                </div>
              </div>
              <div className="post-preview-text">{postPreview.text}</div>
              {postPreview.mediaUrls.length > 0 && (
                <div className="post-preview-media">
                  {postPreview.mediaUrls.map((url, i) => (
                    <img key={i} src={url} alt="" style={{ maxHeight: 200, borderRadius: 8 }} />
                  ))}
                </div>
              )}
            </div>
          )}

          <div style={{ marginTop: 16 }}>
            <div className="form-section-title">Components and Rewards</div>
            {PLATFORMS.map(platform => {
              const config = getSocialConfig(platform.id)
              const actions = getActionsForPlatform(platform.id)
              const selectedAction = ACTIONS.find(a => a.id === config.actionId)
              const perAction = config.amount > 0 && config.budget > 0 ? config.budget / config.amount : 0
              const minPer = selectedAction?.minPer || 0.001
              const maxAmount = selectedAction?.maxPerComponent || 100
              return (
                <div key={platform.id} className="platform-block">
                  <div className="platform-block-header" onClick={() => toggleSocialPlatform(platform.id)}>
                    <div className="platform-block-icon" style={{ background: `${platform.color}15`, color: platform.color }}>
                      <i className={platform.icon} style={{ fontSize: 15 }} />
                    </div>
                    <span className="platform-block-name">{platform.name}</span>
                    <label className="form-checkbox" style={{ margin: 0 }} onClick={e => e.stopPropagation()}>
                      <input type="checkbox" checked={config.enabled} onChange={() => toggleSocialPlatform(platform.id)} />
                      <span style={{ fontSize: 12 }}>Enable</span>
                    </label>
                    <span className={`platform-block-toggle ${config.enabled ? 'open' : ''}`}>▼</span>
                  </div>
                  {config.enabled && (
                    <div className="platform-block-body">
                      <div className="action-chips">
                        {actions.map(action => (
                          <div key={action.id} className={`action-chip ${config.actionId === action.id ? 'active' : ''}`}
                            onClick={() => changePlatformAction(platform.id, action.id)}>
                            {action.label}
                          </div>
                        ))}
                      </div>
                      <div className="form-row" style={{ margin: '8px 0 0' }}>
                        <div className="form-group">
                          <label>Amount</label>
                          <input className="form-input" type="number" min={1} max={maxAmount} step={1}
                            value={config.amount} onChange={e => updateSocialConfig(platform.id, {
                              amount: Math.min(maxAmount, Math.max(1, Number(e.target.value) || 1))
                            })} />
                        </div>
                        <div className="form-group">
                          <label>Budget (SOL)</label>
                          <input className="form-input" type="number" min={minPer} step={0.001}
                            value={config.budget} onChange={e => updateSocialConfig(platform.id, {
                              budget: Math.max(minPer, Number(e.target.value) || minPer)
                            })} />
                          <span className="form-hint">~{formatSol(perAction)} SOL per action</span>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              )
            })}

            {enabledSocialCount > 0 && (
              <div className="summary-card">
                <div className="summary-row"><span>Active Platforms</span><strong>{enabledSocialCount}</strong></div>
                <div className="summary-row"><span>Total Completions</span><strong>{socialTotalCompletions}</strong></div>
                <div className="summary-row"><span>Subtotal</span><strong>{formatSol(socialTotalBudget)} SOL</strong></div>
                <div className="summary-row"><span>Platform Fee (10%)</span><strong>{formatSol(socialFee)} SOL</strong></div>
                <div className="summary-row total"><span>Total</span><strong>{formatSol(socialGrandTotal)} SOL</strong></div>
                <button className="btn btn-primary btn-full" style={{ marginTop: 16 }} onClick={handlePay} disabled={!postUrl.trim()}>
                  Continue to Payment →
                </button>
              </div>
            )}
          </div>
        </div>
      )}

      {jobType === 'custom' && (
        <div className="form-section">
          {/* Inline info section about custom jobs */}
          <div className="custom-job-info" style={{
            background: 'var(--bg2)', border: '1px solid var(--border)', borderRadius: 12, padding: 16, marginBottom: 20,
          }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: 10, marginBottom: 12 }}>
              <div style={{ width: 32, height: 32, borderRadius: 8, background: 'rgba(124,58,237,0.1)', display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#7C3AED', fontSize: 16 }}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              </div>
              <h3 style={{ margin: 0, fontSize: 15, fontWeight: 700, color: 'var(--text)' }}>Understanding Custom Tasks</h3>
            </div>
            <p style={{ fontSize: 13, color: 'var(--text2)', margin: '0 0 12px', lineHeight: 1.5 }}>
              Custom tasks let you create your own job from scratch. You can run challenges with multiple winners or hire one worker for a specific project.
            </p>
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
              <div style={{ borderRadius: 8, border: '1px solid rgba(124,58,237,0.3)', padding: 12, background: 'var(--card)' }}>
                <div style={{ fontSize: 13, fontWeight: 700, color: '#7C3AED', marginBottom: 6 }}>⚡ Challenge Mode</div>
                <ul style={{ margin: 0, padding: '0 0 0 14px', fontSize: 12, color: 'var(--text2)', lineHeight: 1.7 }}>
                  <li>Multiple winners (1-1000)</li>
                  <li>Review all submissions</li>
                  <li>Select the best entries</li>
                  <li>Reward split among winners</li>
                  <li>Best for: design, writing, memes</li>
                </ul>
              </div>
              <div style={{ borderRadius: 8, border: '1px solid var(--border)', padding: 12, background: 'var(--card)' }}>
                <div style={{ fontSize: 13, fontWeight: 700, color: 'var(--text)', marginBottom: 6 }}>🎯 Selection Mode</div>
                <ul style={{ margin: 0, padding: '0 0 0 14px', fontSize: 12, color: 'var(--text2)', lineHeight: 1.7 }}>
                  <li>One winner selected</li>
                  <li>Applicants explain qualifications</li>
                  <li>Direct chat with selected worker</li>
                  <li>Full reward to one person</li>
                  <li>Best for: dev work, consulting</li>
                </ul>
              </div>
            </div>
            <div style={{ marginTop: 10, padding: '8px 12px', borderRadius: 8, background: 'var(--bg)', fontSize: 12, color: 'var(--text3)' }}>
              <strong style={{ color: 'var(--text2)' }}>Pro tip:</strong> Be specific in your task description. Include examples, requirements, and any materials workers will need. Clear tasks get better results.
            </div>
          </div>

          <div className="form-section-title">
            Custom Task Details
            <InfoIcon label="Understanding Custom Tasks" onClick={() => setShowInfoModal(true)} />
          </div>

          <div className="form-row">
            <div className="form-group">
              <label>Task Mode</label>
              <select className="form-select" value={winnerMode} onChange={e => setWinnerMode(e.target.value as WinnerMode)}>
                <option value="challenge">Challenge Mode — Multiple winners</option>
                <option value="selection">Selection Mode — One qualified worker</option>
                <option value="creator_picks">Creator Picks Winners</option>
                <option value="random">Random Selection</option>
              </select>
              <span className="form-hint">
                {winnerMode === 'challenge' ? 'Multiple winners compete. You review and pick the best entries. Best for design, writing, memes.' :
                 winnerMode === 'selection' ? 'One qualified worker is hired. Best for dev work, consulting, long-term tasks.' :
                 'Winners are selected either by you or randomly.'}
              </span>
            </div>
          </div>

          <div className="form-row">
            <div className="form-group">
              <label>Category</label>
              <select className="form-select" value={category} onChange={e => { setCategory(e.target.value); setSubcategory('') }}>
                <option value="">Select a category</option>
                {CATEGORIES.map(c => <option key={c.id} value={c.id}>{c.label}</option>)}
              </select>
            </div>
            <div className="form-group">
              <label>Subcategory</label>
              <select className="form-select" value={subcategory} onChange={e => setSubcategory(e.target.value)} disabled={!category}>
                <option value="">Select subcategory</option>
                {CATEGORIES.find(c => c.id === category)?.subcategories.map(s => <option key={s} value={s}>{s}</option>)}
              </select>
            </div>
          </div>

          <div className="form-group" style={{ marginBottom: 16 }}>
            <label>Task Title</label>
            <input className="form-input" value={title} onChange={e => setTitle(e.target.value)} placeholder="Give your task a clear, descriptive title..." />
          </div>

          <div className="form-group" style={{ marginBottom: 8 }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <label>Description</label>
              <button className="btn btn-sm btn-outline" onClick={() => { setShowTemplates(!showTemplates); setShowTemplates(true) }}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Templates
              </button>
            </div>
            <textarea className="form-textarea" value={description} onChange={e => setDescription(e.target.value)}
              placeholder="Explain what needs to be done. Include requirements, instructions, and any examples..." rows={6} />
            <span className="form-hint">Markdown supported (bold, lists, links). Be clear and detailed to get better results.</span>
          </div>

          {showTemplates && (
            <div style={{ marginBottom: 16, padding: 16, border: '1px solid var(--border)', borderRadius: 10, background: 'var(--bg)' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 }}>
                <span style={{ fontSize: 14, fontWeight: 700, color: 'var(--text)' }}>
                  {templates.length > 0 ? 'Your Templates' : 'Quick Templates'}
                </span>
                <button className="btn btn-sm btn-secondary" onClick={() => setShowTemplates(false)}>✕ Close</button>
              </div>
              {loadingTemplates ? (
                <span style={{ fontSize: 13, color: 'var(--text3)' }}>Loading templates...</span>
              ) : templates.length > 0 ? (
                <div className="template-grid">
                  {templates.map(tpl => (
                    <div key={tpl.id} className="template-card" onClick={() => applyTemplate(tpl)}>
                      <h4>{tpl.label}</h4>
                      <p>{tpl.description?.slice(0, 100)}...</p>
                    </div>
                  ))}
                </div>
              ) : (
                <div className="template-grid">
                  {TEMPLATE_PRESETS.map(preset => (
                    <div key={preset.id} className="template-card" onClick={() => applyPreset(preset)}>
                      <h4>{preset.label}</h4>
                      <p>{preset.description}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          <div className="form-row">
            <div className="form-group">
              <label>Number of Winners</label>
              <input className="form-input" type="number" min={1} max={1000} step={1} value={winners}
                onChange={e => setWinners(Math.min(1000, Math.max(1, Number(e.target.value) || 1)))} />
            </div>
            <div className="form-group">
              <label>Max Entries</label>
              <input className="form-input" type="number" min={1} max={10000} step={1} value={unlimitedEntries ? '' : maxEntries}
                disabled={unlimitedEntries}
                onChange={e => setMaxEntries(Math.min(10000, Math.max(1, Number(e.target.value) || 1)))} />
              <label className="form-checkbox" style={{ marginTop: 4 }}>
                <input type="checkbox" checked={unlimitedEntries} onChange={e => setUnlimitedEntries(e.target.checked)} />
                Unlimited
              </label>
            </div>
          </div>

          <div className="form-row">
            <div className="form-group">
              <label>Hide Submissions</label>
              <select className="form-select" value={hideSubmissions ? 'yes' : 'no'} onChange={e => setHideSubmissions(e.target.value === 'yes')}>
                <option value="no">Visible to everyone</option>
                <option value="yes">Hidden until job closes</option>
              </select>
            </div>
            <div className="form-group">
              <label>Screenshot Proof Required</label>
              <select className="form-select" value={screenshotProof ? 'yes' : 'no'} onChange={e => setScreenshotProof(e.target.value === 'yes')}>
                <option value="yes">Required</option>
                <option value="no">Optional</option>
              </select>
            </div>
          </div>

          <div className="form-row">
            <div className="form-group">
              <label>Winner Selection Mode</label>
              <select className="form-select" value={winnerMode} onChange={e => setWinnerMode(e.target.value as WinnerMode)}>
                <option value="creator_picks">Creator picks winners</option>
                <option value="random">Random selection</option>
                <option value="challenge">Challenge (review submissions)</option>
                <option value="selection">Selection (hire one worker)</option>
              </select>
            </div>
            <div className="form-group">
              <label>Selection Time</label>
              <select className="form-select" value={selectionTime} onChange={e => setSelectionTime(e.target.value)}>
                {SELECTION_TIME_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
              </select>
              <span className="form-hint">After this timer ends, winners are selected</span>
            </div>
          </div>

          <div className="form-row">
            <div className="form-group">
              <label>Audience</label>
              <select className="form-select" value={audience} onChange={e => setAudience(e.target.value as 'all' | 'community')}>
                <option value="all">Everyone</option>
                <option value="community">Specific Community</option>
              </select>
            </div>
            {audience === 'community' && (
              <div className="form-group">
                <label>Select Community</label>
                <input className="form-input" value={communityId} onChange={e => setCommunityId(e.target.value)} placeholder="Enter community ID..." />
              </div>
            )}
          </div>

          <div className="form-group" style={{ marginBottom: 16 }}>
            <label>Search Tags</label>
            <input className="form-input" value={tags} onChange={e => setTags(e.target.value)} placeholder="Comma-separated keywords (e.g. design, logo, social media)" />
          </div>

          {/* Requirements */}
          <div className="form-section-title" style={{ marginTop: 16 }}>
            Requirements
            <InfoIcon label="About requirements" onClick={() => setShowInfoModal(true)} />
          </div>
          <div className="form-row">
            <div className="form-group">
              <label>Minimum Rank</label>
              <select className="form-select" value={reqRank} onChange={e => setReqRank(Number(e.target.value))}>
                <option value={0}>No minimum</option>
                <option value={1}>Rank 1</option>
                <option value={2}>Rank 2</option>
                <option value={3}>Rank 3</option>
              </select>
            </div>
            <div className="form-group">
              <label>Requirement Mode</label>
              <select className="form-select" value={reqMode} onChange={e => setReqMode(e.target.value as RequirementMode)}>
                <option value="default">No extra requirements</option>
                <option value="rank">Rank gate</option>
                <option value="sorsa">Sorsa score</option>
                <option value="x_metrics">X metrics score</option>
                <option value="x_verified">Verified X account</option>
              </select>
            </div>
          </div>
          <label className="form-checkbox" style={{ marginBottom: 16 }}>
            <input type="checkbox" checked={humanVerified} onChange={e => setHumanVerified(e.target.checked)} />
            Human Verified (participants must be human verified)
          </label>

          {/* Extra Settings */}
          <div style={{ marginBottom: 16 }}>
            <button className="extra-settings-toggle" onClick={() => setShowExtraSettings(!showExtraSettings)}>
              <span>Extra Settings</span>
              <span className={`arrow ${showExtraSettings ? 'open' : ''}`}>▼</span>
            </button>
            {showExtraSettings && (
              <div className="extra-settings-body">
                <div className="form-row">
                  <div className="form-group">
                    <label>Cooldown Period</label>
                    <select className="form-select" value={cooldown} onChange={e => setCooldown(e.target.value)}>
                      {COOLDOWN_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
                    </select>
                    <span className="form-hint">Prevents spam and ensures organic reach</span>
                  </div>
                  <div className="form-group">
                    <label>Hide After Completion</label>
                    <select className="form-select" value={hideAfterCompletion ? 'yes' : 'no'} onChange={e => setHideAfterCompletion(e.target.value === 'yes')}>
                      <option value="no">Visible after completion</option>
                      <option value="yes">Hidden when completed</option>
                    </select>
                  </div>
                </div>
              </div>
            )}
          </div>

          {/* Budget */}
          <div className="form-section-title">Budget & Payment</div>
          <div className="form-row">
            <div className="form-group">
              <label>Currency</label>
              <select className="form-select" value={currency} onChange={e => setCurrency(e.target.value as Currency)}>
                <option value="SOL">SOL</option>
                <option value="USDC">USDC</option>
                <option value="NGN">NGN (₦)</option>
              </select>
            </div>
            {currency === 'NGN' ? (
              <>
                <div className="form-group">
                  <label>Total Budget (₦)</label>
                  <input className="form-input" type="number" min={500} step={100} value={ngnBudget}
                    onChange={e => setNgnBudget(Math.max(500, Number(e.target.value) || 500))} />
                  <span className="form-hint">Minimum ₦500</span>
                </div>
                <div className="form-group">
                  <label>Pay Per Worker (₦)</label>
                  <input className="form-input" type="number" min={0} step={10} value={ngnPayPerWorker} readOnly />
                  <span className="form-hint">After 10% platform fee: ₦{(ngnBudget * 0.9 / winners).toFixed(0)} per winner</span>
                </div>
              </>
            ) : (
              <>
                <div className="form-group">
                  <label>Total Budget ({currency})</label>
                  <input className="form-input" type="number" min={0.01} step={0.01} value={budget}
                    onChange={e => setBudget(Math.max(0.01, Number(e.target.value) || 0.01))} />
                  <span className="form-hint">Minimum 0.01 {currency}</span>
                </div>
                <div className="form-group">
                  <label>Pay Per Worker ({currency})</label>
                  <input className="form-input" type="number" min={0} step={0.001} value={payPerWorker} readOnly />
                  <span className="form-hint">After 10% fee: {formatSol(budget * 0.9 / winners)} per winner</span>
                </div>
              </>
            )}
          </div>

          <div className="summary-card">
            <div className="summary-row"><span>Total Budget</span><strong>{currency === 'NGN' ? `₦${ngnBudget.toLocaleString()}` : `${formatSol(budget)} ${currency}`}</strong></div>
            <div className="summary-row"><span>Winners</span><strong>{winners}</strong></div>
            <div className="summary-row"><span>Platform Fee (10%)</span><strong>{currency === 'NGN' ? `₦${(ngnBudget * 0.1).toLocaleString()}` : `${formatSol(budget * 0.1)} ${currency}`}</strong></div>
            <div className="summary-row total">
              <span>Total to Pay</span>
              <strong>{currency === 'NGN' ? `₦${ngnBudget.toLocaleString()}` : `${formatSol(budget)} ${currency}`}</strong>
            </div>
          </div>

          {submitError && <div className="form-error">{submitError}</div>}
          <button className="btn btn-primary btn-full" style={{ marginTop: 16 }} onClick={handlePay} disabled={submitting}>
            {submitting ? 'Creating Task...' : 'Create Task →'}
          </button>
        </div>
      )}

      {jobType === 'select' && (
        <div style={{ textAlign: 'center', padding: '40px 0', color: 'var(--text3)' }}>
          <p>Select a task type above to get started.</p>
        </div>
      )}
    </>
  )

  const renderPayment = () => (
    <>
      <div className="create-header">
        <h1>Payment</h1>
        <p>Complete payment to publish your task.</p>
      </div>

      <div className="summary-card">
        <div className="summary-row"><span>Task Type</span><strong style={{ textTransform: 'capitalize' }}>{jobType}</strong></div>
        <div className="summary-row"><span>Total Budget</span><strong>{formatSol(budget)} SOL</strong></div>
        <div className="summary-row"><span>Platform Fee (10%)</span><strong>{formatSol(budget * 0.1)} SOL</strong></div>
        <div className="summary-row total"><span>Total to Pay</span><strong>{formatSol(budget * 1.1)} SOL</strong></div>
      </div>

      <div style={{ marginTop: 24 }}>
        <h3 style={{ fontSize: 15, fontWeight: 700, color: 'var(--text)', marginBottom: 12 }}>Payment Method</h3>
        <div className="form-row">
          <div className="form-group">
            <select className="form-select" value={currency} onChange={e => setCurrency(e.target.value as Currency)}>
              <option value="SOL">Solana (SOL)</option>
              <option value="USDC">USDC</option>
              <option value="NGN">Bank Transfer (NGN)</option>
            </select>
          </div>
        </div>
        <button className="btn btn-primary btn-full" onClick={() => {
          setShowSuccess(true)
        }}>
          Pay {formatSol(budget * 1.1)} {currency} & Publish
        </button>
      </div>
    </>
  )

  return (
    <Layout>
      <style>{styles}</style>
      <div className="create-page">
        <BreadcrumbSteps step={step} />

        {step === 'choose-type' && renderChooseType()}
        {step === 'payment' && renderPayment()}
      </div>

      <InfoModal open={showInfoModal} onClose={() => setShowInfoModal(false)} />

      {showSuccess && (
        <div className="success-overlay" onClick={() => { setShowSuccess(false); navigate('/tasks') }}>
          <div className="success-card" onClick={e => e.stopPropagation()}>
            <div className="success-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                <path d="M20 6L9 17l-5-5" strokeLinecap="round" strokeLinejoin="round"/>
              </svg>
            </div>
            <h2>Task Created!</h2>
            <p>Your task has been submitted and is now live. Workers can start completing it immediately.</p>
            <button className="btn btn-primary" onClick={() => navigate('/tasks')}>
              View My Tasks
            </button>
          </div>
        </div>
      )}
    </Layout>
  )
}
