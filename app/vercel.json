{
  "version": 2,
  "outputDirectory": "dist",
  "buildCommand": "npm install && npm run build",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)\\.html", "destination": "/$1.html" },
    { "source": "/api/(.*)", "destination": "https://ogapay-production.up.railway.app/api/$1" },
    { "source": "/user/:username", "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawler|spider|facebookexternalhit|whatsapp|slack|discord|telegram|linkedin|embedly|pinterest|skype|reddit|preview).*" }], "destination": "/api/profile-meta?u=:username" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
