# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/ogapay

# ── Auth ─────────────────────────────────────────
JWT_SECRET=change-this-to-a-minimum-32-char-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
FRONTEND_URL=http://localhost:5173

# ── Platform ─────────────────────────────────────
PLATFORM_FEE_PERCENT=10
NODE_ENV=development
API_VERSION=v1

# ── Payment Providers ────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# ── Image Uploads (ImageKit) ─────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-account

# ── AI Features ──────────────────────────────────
OPENAI_API_KEY=

# ── Email (SMTP) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@ogapay.com

# ── Supabase (optional, for backup auth) ─────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
